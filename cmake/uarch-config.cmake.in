@PACKAGE_INIT@
# Target-prefixed musl Clang wrappers do not ship a target-prefixed clang-scan-deps,
# and the reflection headers are non-modular.
if(NOT DEFINED CMAKE_CXX_SCAN_FOR_MODULES)
  set(CMAKE_CXX_SCAN_FOR_MODULES OFF)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/UarchReflection.cmake")
uarch_detect_reflection()
include("${CMAKE_CURRENT_LIST_DIR}/UarchRuntime.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/uarch-targets.cmake")
if(TARGET uarch::primitives AND NOT TARGET uarch::freestanding)
  add_library(uarch::freestanding ALIAS uarch::primitives)
endif()
if(NOT TARGET uarch::detect)
  message(FATAL_ERROR "uarch::detect is not exported")
endif()
check_required_components(uarch)
