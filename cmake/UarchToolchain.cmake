include_guard(GLOBAL)

# Presets and the CLI name a toolchain before project() can see a compiler id.
if(DEFINED ENV{UARCH_TOOLCHAIN_ROOT} AND NOT "$ENV{UARCH_TOOLCHAIN_ROOT}" STREQUAL "")
  set(_uarch_toolchain_root_default "$ENV{UARCH_TOOLCHAIN_ROOT}")
else()
  set(_uarch_toolchain_root_default "$ENV{HOME}/.local/toolchain")
endif()
set(UARCH_TOOLCHAIN_ROOT "${_uarch_toolchain_root_default}" CACHE PATH
  "Root directory for prebuilt C++26 toolchains")
set(UARCH_TOOLCHAIN_NAME "" CACHE STRING
  "Toolchain SDK: clang-glibc, clang-musl, gcc-glibc, or gcc-musl")
set_property(CACHE UARCH_TOOLCHAIN_NAME PROPERTY STRINGS clang-glibc clang-musl gcc-glibc gcc-musl)
set(UARCH_TOOLCHAIN_RELEASE_TAG "v0.0.1" CACHE STRING "GitHub release tag for prebuilt toolchains")
option(UARCH_AUTO_DOWNLOAD_TOOLCHAIN "Download a missing prebuilt toolchain" ON)

function(_uarch_default_distro out_var)
  # v0.0.1 release assets use these suffixes, not the host's VERSION_ID.
  set(distro "ubuntu22")
  if(EXISTS "/etc/os-release")
    file(STRINGS "/etc/os-release" release_lines)
    set(release_id "")
    set(release_like "")
    foreach(line IN LISTS release_lines)
      if(line MATCHES "^ID=(.+)$")
        set(release_id "${CMAKE_MATCH_1}")
        string(REPLACE "\"" "" release_id "${release_id}")
      elseif(line MATCHES "^ID_LIKE=(.+)$")
        set(release_like "${CMAKE_MATCH_1}")
        string(REPLACE "\"" "" release_like "${release_like}")
      endif()
    endforeach()
    set(identity "${release_id} ${release_like}")
    if(identity MATCHES "(^| )alinux( |$)")
      set(distro "alinux3")
    elseif(identity MATCHES "(^| )amzn( |$)")
      set(distro "amazonlinux2")
    elseif(identity MATCHES "(^| )(rhel|rocky|centos|almalinux|fedora)( |$)")
      set(distro "centos7")
    elseif(identity MATCHES "(^| )(ubuntu|debian)( |$)")
      set(distro "ubuntu22")
    endif()
  endif()
  set(${out_var} "${distro}" PARENT_SCOPE)
endfunction()

if(NOT DEFINED UARCH_TOOLCHAIN_DISTRO OR UARCH_TOOLCHAIN_DISTRO STREQUAL "")
  _uarch_default_distro(_uarch_detected_distro)
else()
  set(_uarch_detected_distro "${UARCH_TOOLCHAIN_DISTRO}")
endif()
set(UARCH_TOOLCHAIN_DISTRO "${_uarch_detected_distro}" CACHE STRING
  "Distro tag used in prebuilt toolchain archive names")

function(_uarch_toolchain_spec name out_repo out_prefix out_compiler)
  if(name STREQUAL "clang-glibc")
    set(repo "trunkszi/clang-cross")
    set(prefix "x86_64-unknown-linux-gnu")
    set(compiler "bin/clang++")
  elseif(name STREQUAL "clang-musl")
    set(repo "trunkszi/clang-cross")
    set(prefix "x86_64-unknown-linux-musl")
    set(compiler "bin/x86_64-unknown-linux-musl-clang++")
  elseif(name STREQUAL "gcc-glibc")
    set(repo "trunkszi/gnu-cross")
    set(prefix "x86_64-unknown-linux-gnu")
    set(compiler "bin/x86_64-unknown-linux-gnu-g++")
  elseif(name STREQUAL "gcc-musl")
    set(repo "trunkszi/musl-cross")
    set(prefix "x86_64-unknown-linux-musl")
    set(compiler "bin/x86_64-unknown-linux-musl-g++")
  else()
    message(FATAL_ERROR "Unknown UARCH_TOOLCHAIN_NAME '${name}'")
  endif()
  set(${out_repo} "${repo}" PARENT_SCOPE)
  set(${out_prefix} "${prefix}" PARENT_SCOPE)
  set(${out_compiler} "${compiler}" PARENT_SCOPE)
endfunction()

function(_uarch_infer_toolchain_name out_var)
  if(NOT UARCH_TOOLCHAIN_NAME STREQUAL "")
    set(${out_var} "${UARCH_TOOLCHAIN_NAME}" PARENT_SCOPE)
    return()
  endif()
  set(inferred "")
  if(CMAKE_CXX_COMPILER)
    foreach(candidate IN ITEMS clang-glibc clang-musl gcc-glibc gcc-musl)
      string(FIND "${CMAKE_CXX_COMPILER}" "${UARCH_TOOLCHAIN_ROOT}/${candidate}/" position)
      if(position EQUAL 0)
        set(inferred "${candidate}")
        break()
      endif()
    endforeach()
  endif()
  set(${out_var} "${inferred}" PARENT_SCOPE)
endfunction()

function(_uarch_make_writable dir_path)
  if(EXISTS "${dir_path}")
    execute_process(COMMAND chmod -R u+w "${dir_path}" RESULT_VARIABLE chmod_status)
    if(NOT chmod_status EQUAL 0)
      message(FATAL_ERROR "Failed to restore write permissions on ${dir_path}")
    endif()
  endif()
endfunction()

function(_uarch_ensure_clang_glibc_cfg sdk_dir)
  # The v0.0.1 clang-cross archive has no cfg, so a fresh clang++ cannot find libc++ or the sysroot.
  if(NOT EXISTS "${sdk_dir}/bin/clang++.cfg" OR NOT EXISTS "${sdk_dir}/bin/clang.cfg")
    _uarch_make_writable("${sdk_dir}/bin")
  endif()
  if(NOT EXISTS "${sdk_dir}/bin/clang++.cfg")
    file(WRITE "${sdk_dir}/bin/clang++.cfg"
"--sysroot=<CFGDIR>/../x86_64-unknown-linux-gnu/sysroot
--gcc-toolchain=<CFGDIR>/..
-stdlib=libc++
-Wl,-rpath,<CFGDIR>/../x86_64-unknown-linux-gnu/sysroot/usr/lib
-Wl,-rpath,<CFGDIR>/../lib/x86_64-unknown-linux-gnu
")
  endif()
  if(NOT EXISTS "${sdk_dir}/bin/clang.cfg")
    file(WRITE "${sdk_dir}/bin/clang.cfg"
"--sysroot=<CFGDIR>/../x86_64-unknown-linux-gnu/sysroot
--gcc-toolchain=<CFGDIR>/..
")
  endif()
  if(NOT EXISTS "${sdk_dir}/bin/clang++.cfg" OR NOT EXISTS "${sdk_dir}/bin/clang.cfg")
    message(FATAL_ERROR "Failed to write clang cfg files in ${sdk_dir}/bin")
  endif()
endfunction()

function(_uarch_provision_sdk sdk_name distro)
  _uarch_toolchain_spec("${sdk_name}" repo prefix rel_compiler)
  set(install_dir "${UARCH_TOOLCHAIN_ROOT}/${sdk_name}")
  set(compiler_path "${install_dir}/${rel_compiler}")
  if(EXISTS "${compiler_path}")
    if(sdk_name STREQUAL "clang-glibc")
      _uarch_ensure_clang_glibc_cfg("${install_dir}")
    endif()
    return()
  endif()
  if(NOT UARCH_AUTO_DOWNLOAD_TOOLCHAIN)
    message(FATAL_ERROR
      "Toolchain compiler is missing: ${compiler_path}. Install it or enable UARCH_AUTO_DOWNLOAD_TOOLCHAIN.")
  endif()
  # clang-glibc and gcc-glibc publish the same archive basename from different repositories.
  file(MAKE_DIRECTORY "${UARCH_TOOLCHAIN_ROOT}")
  file(LOCK "${UARCH_TOOLCHAIN_ROOT}/.uarch-${sdk_name}.lock" GUARD FUNCTION TIMEOUT 600)
  if(EXISTS "${compiler_path}")
    if(sdk_name STREQUAL "clang-glibc")
      _uarch_ensure_clang_glibc_cfg("${install_dir}")
    endif()
    return()
  endif()
  set(archive_name "${prefix}-${distro}.tar.xz")
  set(url "https://github.com/${repo}/releases/download/${UARCH_TOOLCHAIN_RELEASE_TAG}/${archive_name}")
  set(download_dir "${UARCH_TOOLCHAIN_ROOT}/downloads")
  file(MAKE_DIRECTORY "${download_dir}")
  set(archive_path "${download_dir}/${sdk_name}-${archive_name}")
  set(digest_path "${archive_path}.sha256")
  message(STATUS "Downloading toolchain ${url}")
  file(DOWNLOAD "${url}" "${archive_path}" STATUS archive_status TLS_VERIFY ON TIMEOUT 600)
  list(GET archive_status 0 archive_code)
  if(NOT archive_code EQUAL 0)
    list(GET archive_status 1 archive_message)
    message(FATAL_ERROR "Toolchain download failed: ${url} (${archive_message})")
  endif()
  file(DOWNLOAD "${url}.sha256" "${digest_path}" STATUS digest_status TLS_VERIFY ON TIMEOUT 120)
  list(GET digest_status 0 digest_code)
  if(NOT digest_code EQUAL 0)
    list(GET digest_status 1 digest_message)
    message(FATAL_ERROR "Toolchain checksum download failed: ${url}.sha256 (${digest_message})")
  endif()
  file(READ "${digest_path}" digest_text)
  string(REGEX MATCH "[A-Fa-f0-9]+" expected_digest "${digest_text}")
  string(LENGTH "${expected_digest}" digest_length)
  if(NOT digest_length EQUAL 64)
    message(FATAL_ERROR "Toolchain checksum file has no SHA256 digest: ${digest_path}")
  endif()
  string(TOLOWER "${expected_digest}" expected_digest)
  file(SHA256 "${archive_path}" actual_digest)
  string(TOLOWER "${actual_digest}" actual_digest)
  if(NOT actual_digest STREQUAL expected_digest)
    message(FATAL_ERROR "Toolchain SHA256 mismatch for ${archive_name}")
  endif()
  # Extract away from the live directory so a killed configure cannot leave a partial SDK.
  set(staging_dir "${UARCH_TOOLCHAIN_ROOT}/.staging-${sdk_name}")
  _uarch_make_writable("${staging_dir}")
  file(REMOVE_RECURSE "${staging_dir}")
  file(MAKE_DIRECTORY "${staging_dir}")
  execute_process(COMMAND tar -xJf "${archive_path}" -C "${staging_dir}" --strip-components=1
    RESULT_VARIABLE tar_status)
  if(NOT tar_status EQUAL 0)
    _uarch_make_writable("${staging_dir}")
    file(REMOVE_RECURSE "${staging_dir}")
    message(FATAL_ERROR "Failed to extract ${archive_path}")
  endif()
  # Release archives preserve read-only directory modes even for their owner.
  _uarch_make_writable("${staging_dir}")
  if(NOT EXISTS "${staging_dir}/${rel_compiler}")
    _uarch_make_writable("${staging_dir}")
    file(REMOVE_RECURSE "${staging_dir}")
    message(FATAL_ERROR "Toolchain archive did not contain ${rel_compiler}")
  endif()
  if(sdk_name STREQUAL "clang-glibc")
    _uarch_ensure_clang_glibc_cfg("${staging_dir}")
  endif()
  if(EXISTS "${install_dir}")
    _uarch_make_writable("${install_dir}")
    file(REMOVE_RECURSE "${install_dir}")
  endif()
  file(RENAME "${staging_dir}" "${install_dir}")
endfunction()

function(uarch_ensure_toolchain)
  # project() defines PROJECT_IS_TOP_LEVEL; this runs before that command.
  if(DEFINED PROJECT_IS_TOP_LEVEL)
    if(NOT PROJECT_IS_TOP_LEVEL)
      return()
    endif()
  elseif(NOT CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
    return()
  endif()
  _uarch_infer_toolchain_name(toolchain_name)
  if(toolchain_name STREQUAL "")
    return()
  endif()
  _uarch_toolchain_spec("${toolchain_name}" repo prefix rel_compiler)
  set(install_dir "${UARCH_TOOLCHAIN_ROOT}/${toolchain_name}")
  set(compiler_path "${install_dir}/${rel_compiler}")
  set(uses_sdk FALSE)
  if(NOT CMAKE_CXX_COMPILER OR CMAKE_CXX_COMPILER STREQUAL "${compiler_path}")
    set(uses_sdk TRUE)
  endif()
  string(FIND "${CMAKE_CXX_COMPILER}" "${install_dir}/" sdk_prefix)
  if(sdk_prefix EQUAL 0)
    set(uses_sdk TRUE)
  endif()
  if(uses_sdk)
    _uarch_provision_sdk("${toolchain_name}" "${UARCH_TOOLCHAIN_DISTRO}")
  endif()
  if(EXISTS "${compiler_path}" AND NOT CMAKE_CXX_COMPILER)
    set(CMAKE_CXX_COMPILER "${compiler_path}" CACHE FILEPATH "C++ compiler" FORCE)
  endif()
  if(uses_sdk AND NOT EXISTS "${compiler_path}")
    message(FATAL_ERROR "Toolchain archive did not contain ${rel_compiler}")
  endif()
  # option() has not run yet. -D defines these; otherwise llvm tools and the foreign compiler
  # are required whenever tests or tools will be built.
  if(NOT DEFINED UARCH_BUILD_TESTS OR UARCH_BUILD_TESTS OR UARCH_BUILD_TOOLS)
    _uarch_provision_sdk("clang-glibc" "${UARCH_TOOLCHAIN_DISTRO}")
    _uarch_provision_sdk("gcc-glibc" "${UARCH_TOOLCHAIN_DISTRO}")
  endif()
endfunction()

function(uarch_resolve_llvm_tools_dir out_var)
  # The verifier calls ${dir}/clang++. A musl SDK directory also contains
  # llvm-objdump, but its unprefixed clang++ does not search that SDK's libc++.
  set(resolved "${UARCH_TOOLCHAIN_ROOT}/clang-glibc/bin")
  if(CMAKE_CXX_COMPILER)
    cmake_path(GET CMAKE_CXX_COMPILER PARENT_PATH compiler_bin)
    cmake_path(GET CMAKE_CXX_COMPILER FILENAME compiler_name)
    if(compiler_name STREQUAL "clang++" AND EXISTS "${compiler_bin}/llvm-objdump")
      set(resolved "${compiler_bin}")
    endif()
  endif()
  set(${out_var} "${resolved}" PARENT_SCOPE)
endfunction()

function(uarch_resolve_opposite_compiler out_compiler_var out_flags_var)
  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    set(compiler "${UARCH_TOOLCHAIN_ROOT}/gcc-glibc/bin/x86_64-unknown-linux-gnu-g++")
    set(flags -freflection)
  elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    set(compiler "${UARCH_TOOLCHAIN_ROOT}/clang-glibc/bin/clang++")
    set(flags -freflection-latest -stdlib=libc++)
  else()
    message(FATAL_ERROR "cross ABI requires Clang or GCC")
  endif()
  set(${out_compiler_var} "${compiler}" PARENT_SCOPE)
  set(${out_flags_var} "${flags}" PARENT_SCOPE)
endfunction()
