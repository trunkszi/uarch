include_guard(GLOBAL)

function(_uarch_resolve_runtime out_musl out_loader)
  string(SHA256 compiler_key "${CMAKE_CXX_COMPILER}")
  set(property_prefix "UARCH_RUNTIME_${compiler_key}")
  get_property(probed GLOBAL PROPERTY "${property_prefix}_TRIPLE" SET)
  if(NOT probed)
    execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -dumpmachine
      OUTPUT_VARIABLE target_triple OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE triple_status)
    set(loader_name "")
    if(triple_status EQUAL 0 AND target_triple MATCHES "musl")
      set(loader_name "ld-musl-x86_64.so.1")
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
      set(loader_name "ld-linux-x86-64.so.2")
    endif()
    set(runtime_loader "")
    if(NOT loader_name STREQUAL "")
      execute_process(COMMAND "${CMAKE_CXX_COMPILER}" "-print-file-name=${loader_name}"
        OUTPUT_VARIABLE candidate OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE loader_status)
      if(loader_status EQUAL 0 AND IS_ABSOLUTE "${candidate}" AND EXISTS "${candidate}")
        set(runtime_loader "${candidate}")
      endif()
    endif()
    # Global properties expire each configure and isolate discovery for different compiler executables.
    set_property(GLOBAL PROPERTY "${property_prefix}_TRIPLE" "${target_triple}")
    set_property(GLOBAL PROPERTY "${property_prefix}_STATUS" "${triple_status}")
    set_property(GLOBAL PROPERTY "${property_prefix}_LOADER" "${runtime_loader}")
  endif()
  get_property(target_triple GLOBAL PROPERTY "${property_prefix}_TRIPLE")
  get_property(triple_status GLOBAL PROPERTY "${property_prefix}_STATUS")
  get_property(runtime_loader GLOBAL PROPERTY "${property_prefix}_LOADER")
  set(is_musl FALSE)
  if(triple_status EQUAL 0 AND target_triple MATCHES "musl")
    set(is_musl TRUE)
  endif()
  set(${out_musl} "${is_musl}" PARENT_SCOPE)
  set(${out_loader} "${runtime_loader}" PARENT_SCOPE)
endfunction()

function(uarch_configure_runtime target)
  _uarch_resolve_runtime(is_musl runtime_loader)
  get_target_property(link_options ${target} LINK_OPTIONS)
  if("${CMAKE_EXE_LINKER_FLAGS};${link_options}" MATCHES "(^|[;, :])--dynamic-linker([=,; ]|$)")
    # An explicit loader follows the caller's libc selection, not the compiler's default sysroot.
    foreach(directory IN LISTS CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES)
      if(NOT directory MATCHES "/sysroot(/|$)")
        set_property(TARGET ${target} APPEND PROPERTY BUILD_RPATH "${directory}")
      endif()
    endforeach()
    return()
  endif()
  if(is_musl)
    set_property(TARGET ${target} APPEND PROPERTY BUILD_RPATH "${CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES}")
    # CI hosts need not have the musl loader installed in the system library directory.
    if(NOT runtime_loader STREQUAL "")
      target_link_options(${target} PRIVATE "LINKER:--dynamic-linker,${runtime_loader}")
    endif()
  elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    set_property(TARGET ${target} APPEND PROPERTY BUILD_RPATH "${CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES}")
    # A sysroot libc in RUNPATH must use its matching loader, not the host glibc loader.
    if(NOT runtime_loader STREQUAL "")
      target_link_options(${target} PRIVATE "LINKER:--dynamic-linker,${runtime_loader}")
    endif()
  else()
    foreach(directory IN LISTS CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES)
      # Use compiler runtimes without replacing the host loader's libc.
      if(NOT directory MATCHES "/sysroot(/|$)")
        set_property(TARGET ${target} APPEND PROPERTY BUILD_RPATH "${directory}")
      endif()
    endforeach()
  endif()
endfunction()
