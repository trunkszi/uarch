add_library(detect_fixture OBJECT unit/detect/cpuid_test.cc)
uarch_configure_internal(detect_fixture)
target_compile_definitions(detect_fixture PRIVATE UARCH_TEST_SUPPORT_ONLY=1)
foreach(name IN ITEMS cpuid quirks policy host detect)
  uarch_add_test(${name}_test unit/detect/${name}_test.cc)
